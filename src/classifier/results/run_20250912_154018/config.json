{
  "model_config": {
    "input_size": 2,
    "hidden_layers": [
      512,
      256,
      128
    ],
    "output_size": 1,
    "activation": "ReLU",
    "dropout_rate": 0.3,
    "use_batch_norm": true,
    "learning_rate": 0.001,
    "weight_decay": 0.0001,
    "amp_enabled": false
  },
  "training_config": {
    "max_epochs": 100,
    "patience": 10,
    "min_delta": 0.0001,
    "use_scheduler": true,
    "scheduler_factor": 0.5,
    "scheduler_patience": 5,
    "scheduler_min_lr": 1e-06,
    "amp_enabled": false,
    "amp_dtype": "torch.float16",
    "gradient_clip_value": null,
    "gradient_clip_norm": null,
    "log_interval": 10,
    "save_best_model": true,
    "save_checkpoint_interval": null,
    "monitor_metric": "roc_auc",
    "monitor_mode": "max",
    "validate_every": 1
  },
  "feature_names": [
    "feature_1",
    "feature_2"
  ],
  "device": "cpu"
}