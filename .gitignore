# ============================================
# DockTKinase - Git Ignore Configuration
# ============================================

# ============================================
# Generated Output Directories
# ============================================
# Embedding outputs
ligand/
protein/
ligand_embeddings/
protein_embeddings/
matrix_embedding/
test_output*/

# Result directories (now in tests/)
tests/humans/
tests/non_humans/
tests/test_output*/
tests/pipeline_output*/
tests/comparison_*/
results/
output/

# ⚠️ IMPORTANTE: Pastas de teste na RAIZ não devem ser criadas!
# Todos os testes devem ir para tests/
# Mas se forem criadas acidentalmente na raiz, serão ignoradas:
/test_*/
/comparison_*/
/pipeline_output/

# ============================================
# Logs and Temporary Files
# ============================================
logs/
tmp/
*.log
*.tmp
log.txt
processed_files.log

# ============================================
# Checkpoints
# ============================================
*_checkpoint.txt
preparation_checkpoint.txt
embedding_checkpoint.txt

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
/build/               # Apenas /build/ na raiz (não src/build/)
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ============================================
# Data Files
# ============================================
# NumPy arrays
*.npy

# Data formats
*.tsv
*.csv
*.json
*.parquet

# Model weights
*.pth
*.pt
*.ckpt

# Archives
*.tar.xz
*.tar.gz
*.zip

# ============================================
# Model Caches
# ============================================
llm/models_cache/*           # Ignorar todo o conteúdo da pasta llm
!llm/models_cache/README.md  # Exceto README
!llm/models_cache/ESM/       # Permitir pasta ESM (para README futuro)

.cache/
FM4M/models/*/model_files/
FM4M/model_files/
FM4M/data/
FM4M/model_files/

# CatBoost training info
catboost_info/

# ESM model weights (downloaded via torch.hub)
# Código fonte em ESM/ é versionado, mas modelos baixados não
llm/models_cache/ESM/*.pt
llm/models_cache/ESM/*.bin
llm/models_cache/ESM/checkpoints/
llm/models_cache/ESM/hub/
*.pt  # PyTorch model weights
*.bin  # Binary model files

# ============================================
# IDE and Editor
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ============================================
# Testing
# ============================================
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# ============================================
# Documentation
# ============================================
# Keep docs/ in version control
# Only ignore generated docs
docs/_build/
site/

# ============================================
# Notebooks
# ============================================
.ipynb_checkpoints/
*.ipynb
FM4M/examples/*.ipynb

# ============================================
# Images and Media
# ============================================
*.png
!semantic-screening-DT-kinase.png
!docs/l4_architecture_workflow.png
!docs/l4_architecture_nature.png
*.jpg
*.jpeg
*.gif
*.svg
FM4M/img/test.py

# ESM - exclude downloaded models but keep source code
ESM/*
!ESM/esm-3/
!ESM/.gitkeep

# LLM folder - ignorar apenas arquivos de modelo, não código fonte
llm/models_cache/**/*.pt
llm/models_cache/**/*.bin
llm/models_cache/**/*.ckpt
llm/FM4M/model_files/*.pt
llm/FM4M/model_files/*.bin
llm/FM4M/data/

# Results and outputs
results/
tests/comparison_output/
tests/pipeline_output/
tests/test_output_small/
tests/regression_modular_test/

# Temporary files
tmp/

# Test datasets (keep structure but ignore data)
tests/datasets/*.tsv
tests/datasets/*.csv
tests/datasets/datasets/

# Model files (large binary files)
model_files/

# macOS system files
.DS_Store
**/.DS_Store
llm/models_cache/
.claude/

# ============================================
# Committee inference artifacts (track subset)
# ============================================
# Override blanket rules (results/, *.pt, *.pth, *.json) to track the
# minimal weights + calibrations consumed by
# scripts/inference/models/{dtkinase,drugban,graphban,conplex}_score.py.
# Only seed_42 (rep0 for ConPLex) representatives are versioned; full
# 5-seed ensembles stay local. See CLAUDE.md "Committee model artifacts".

# Baseline calibration sidecars (parent dirs not in any .gitignore;
# only blocked by *.json above). Restrict to seed_42 — full 5-seed
# calibrations stay local.
!**/seed_42/drugban_calibration.json
!**/seed_42/graphban_calibration.json
!**/seed_42/conplex_calibration.json

# DT-Kinase L4 CNN: parent-dir dance to expose 3 ckpts + 3 calibrations
# inside the gitignored results/ tree. Re-include each parent, re-exclude
# its other children, then re-include the target leaves.
!results/
results/*
!results/benchmark_human_8M_13_05_2026/
results/benchmark_human_8M_13_05_2026/*
!results/benchmark_human_8M_13_05_2026/test/
results/benchmark_human_8M_13_05_2026/test/*
!results/benchmark_human_8M_13_05_2026/test/level4_cnn_8M/
results/benchmark_human_8M_13_05_2026/test/level4_cnn_8M/*
!results/benchmark_human_8M_13_05_2026/test/level4_cnn_8M/human/
results/benchmark_human_8M_13_05_2026/test/level4_cnn_8M/human/*
!results/benchmark_human_8M_13_05_2026/test/level4_cnn_8M/human/seed_42/
results/benchmark_human_8M_13_05_2026/test/level4_cnn_8M/human/seed_42/*
!results/benchmark_human_8M_13_05_2026/test/level4_cnn_8M/human/seed_42/level4_cnn_model.pt
!results/benchmark_human_8M_13_05_2026/test/level4_cnn_8M/human/seed_42/level4_cnn_calibration.json

!results/benchmark_non_human_8M_13_05_2026_v3/
results/benchmark_non_human_8M_13_05_2026_v3/*
!results/benchmark_non_human_8M_13_05_2026_v3/test/
results/benchmark_non_human_8M_13_05_2026_v3/test/*
!results/benchmark_non_human_8M_13_05_2026_v3/test/level4_cnn_8M/
results/benchmark_non_human_8M_13_05_2026_v3/test/level4_cnn_8M/*
!results/benchmark_non_human_8M_13_05_2026_v3/test/level4_cnn_8M/non_human/
results/benchmark_non_human_8M_13_05_2026_v3/test/level4_cnn_8M/non_human/*
!results/benchmark_non_human_8M_13_05_2026_v3/test/level4_cnn_8M/non_human/seed_42/
results/benchmark_non_human_8M_13_05_2026_v3/test/level4_cnn_8M/non_human/seed_42/*
!results/benchmark_non_human_8M_13_05_2026_v3/test/level4_cnn_8M/non_human/seed_42/level4_cnn_model.pt
!results/benchmark_non_human_8M_13_05_2026_v3/test/level4_cnn_8M/non_human/seed_42/level4_cnn_calibration.json

!results/all/
results/all/*
!results/all/benchmark_all_8M_13_04_2026/
results/all/benchmark_all_8M_13_04_2026/*
!results/all/benchmark_all_8M_13_04_2026/test/
