# ============================================
# attention-screening — public release .gitignore
# ============================================

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env_baseline/
.conda/
/build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ============================================
# Editor / IDE
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
**/.DS_Store

# ============================================
# Logs / Temp
# ============================================
logs/
tmp/
*.log
*.tmp
log.txt
processed_files.log
*_checkpoint.txt

# ============================================
# Notebooks
# ============================================
.ipynb_checkpoints/
*.ipynb

# ============================================
# Testing
# ============================================
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# ============================================
# Model weights (download via Zenodo)
# ============================================
*.pt
*.pth
*.ckpt
*.bin
*.safetensors
*.joblib
*.pkl

# ============================================
# Model caches (download on demand)
# ============================================
llm/models_cache/
llm/FM4M/model_files/
llm/FM4M/data/
ConPLex/models/
.cache/
catboost_info/
model_files/
**/feature_cache/

# ============================================
# Datasets (download via Zenodo)
# ============================================
*.csv
*.tsv
*.tsv.gz
*.parquet
*.npy
*.h5
*.a3m
*.sto
*.cif
*.pdb

# ============================================
# Results & outputs — block content by extension above,
# enumerate specific subtrees here (avoid parent-dir block
# so reproducibility artifacts remain trackable).
# ============================================
output/
tests/datasets/
tests/comparison_*/
tests/pipeline_output*/
tests/test_output*/
tests/regression_modular_test/
tests/humans/
tests/non_humans/
ligand/
protein/
ligand_embeddings/
protein_embeddings/
matrix_embedding/
scaffolds_splits/output/
data/chemglam/universal/train_valid_split.json
ConPLex/dataset/kinase_all/
ConPLex/dataset/kinase_human/
ConPLex/dataset/kinase_non_human/
ConPLex/best_models/
DrugBAN/datasets/kinase/
GraphBAN/upstream_data/

# Block heavy intermediate dirs under results/ (specific paths;
# raw_predictions.npz, *_calibration.json, *_results.json stay
# trackable since *.pt and *.csv handle the heavy files).
results/**/feature_cache/
results/**/*_intermediate/
results/results/
results/conplex/
results/drugban/
results/graphban/

# DrugBAN/GraphBAN results: track only small artifacts via
# *.pt/*.pth ignore above; .npz/.json sidecars remain trackable.

# ============================================
# Override: keep small reproducibility artifacts trackable
# ============================================
!**/*_calibration.json
!**/raw_predictions.npz
!**/*_results.json
!**/seed_summary.csv
!**/seeds_summary.csv
!configs/*.yaml
!configs/*.json
!**/README.md
!**/LICENSE
!**/LICENSE.md
!**/CITATION.cff
!**/CITATION.md

# ============================================
# Docs build artifacts
# ============================================
docs/_build/
site/

# ============================================
# Local agent worktrees / local configs
# ============================================
.claude/
.codex/
.mcp.json
.mcp.json.bak.*
.github/hooks/

# ============================================
# Third-party libraries (not redistributed; install separately)
# ============================================
llm/

# ============================================
# Personal project notes (local-only)
# ============================================
results/CLAUDE.md
CLAUDE.md
AGENTS.md
CODEX.md

# ============================================
# Archives
# ============================================
*.tar
*.tar.gz
*.tar.xz
*.zip
*.rar
*.7z

# ============================================
# Images (track only repo-essential ones)
# ============================================
*.png
*.jpg
*.jpeg
*.gif
*.svg
!docs/**/*.png
!docs/**/*.svg
!figures/**/*.png
!figures/**/*.svg
!README*.png
