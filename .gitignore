# ============================================
# DockTKinase - Git Ignore Configuration
# ============================================

# ============================================
# Generated Output Directories
# ============================================
# Embedding outputs
ligand/
protein/
ligand_embeddings/
protein_embeddings/
matrix_embedding/
test_output*/

# Result directories (now in tests/)
tests/humans/
tests/non_humans/
tests/test_output*/
tests/pipeline_output*/
tests/comparison_*/
results/
output/

# ⚠️ IMPORTANTE: Pastas de teste na RAIZ não devem ser criadas!
# Todos os testes devem ir para tests/
# Mas se forem criadas acidentalmente na raiz, serão ignoradas:
/test_*/
/comparison_*/
/pipeline_output/

# ============================================
# Logs and Temporary Files
# ============================================
logs/
tmp/
*.log
*.tmp
log.txt
processed_files.log

# ============================================
# Checkpoints
# ============================================
*_checkpoint.txt
preparation_checkpoint.txt
embedding_checkpoint.txt

# ============================================
# Python
# ============================================
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
/build/               # Apenas /build/ na raiz (não src/build/)
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ============================================
# Data Files
# ============================================
# NumPy arrays
*.npy

# Data formats
*.tsv
*.csv
*.json
*.parquet

# Model weights
*.pth
*.pt
*.ckpt

# Archives
*.tar.xz
*.tar.gz
*.zip

# ============================================
# Model Caches
# ============================================
models_cache/*               # Ignorar todo o conteúdo
!models_cache/README.md      # Exceto README
!models_cache/ESM/           # Permitir pasta ESM (para README futuro)

.cache/
FM4M/models/*/model_files/
FM4M/data/
FM4M/model_files/

# ESM model weights (downloaded via torch.hub)
# Código fonte em ESM/ é versionado, mas modelos baixados não
models_cache/ESM/*.pt
models_cache/ESM/*.bin
models_cache/ESM/checkpoints/
models_cache/ESM/hub/
*.pt  # PyTorch model weights
*.bin  # Binary model files

# ============================================
# IDE and Editor
# ============================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store

# ============================================
# Testing
# ============================================
.pytest_cache/
.coverage
htmlcov/
.tox/
.hypothesis/

# ============================================
# Documentation
# ============================================
# Keep docs/ in version control
# Only ignore generated docs
docs/_build/
site/

# ============================================
# Notebooks
# ============================================
.ipynb_checkpoints/
*.ipynb
FM4M/examples/*.ipynb

# ============================================
# Images and Media
# ============================================
*.png
*.jpg
*.jpeg
*.gif
*.svg
FM4M/img/test.py
