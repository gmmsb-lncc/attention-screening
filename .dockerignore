# =============================================================================
# Docker context — aggressively trim 44GB repo to ~3GB image
# =============================================================================

# VCS / dev tooling
.git
.gitignore
.github
.vscode/
.idea/
*.swp
*.swo
.DS_Store
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Local Python envs (rebuilt inside image via setup_baseline_env.sh)
env/
env_baseline/
**/__pycache__/
**/*.pyc
**/*.pyo

# Local Claude/agent state (heavy — 100s of MB worktrees)
.claude/

# Cloned upstream ESM (HF transformers covers ESM-2 8M used by inference)
llm/

# Top-level repo examples (the inference demos under scripts/inference/examples
# are kept).
/examples/

# Heavy training datasets (415MB TSVs not needed for inference)
tests/datasets/

# Heavy scaffold split files — keep only TSVs + manifest required by demos
scaffolds_splits/output/scenarios/
scaffolds_splits/output/universal_train.tsv
scaffolds_splits/output/universal_val.tsv
scaffolds_splits/output/human_train.tsv
scaffolds_splits/output/human_val.tsv
scaffolds_splits/output/human_test.tsv
scaffolds_splits/output/*.tsv.gz

# Misc dev outputs
docs/
crossattention_split_analysis/
data/
GEMINI.md
*.code-workspace
scaffolds_splits/work/

